<Window x:Class="LolAccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lol Account Switcher" 
        Icon="app.ico"
        Width="640"
        MinWidth="580"
        MaxWidth="800"
        SizeToContent="Height"
        MaxHeight="850"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        MouseDown="Window_MouseDown">

    <!-- ANA PENCERE ÇERÇEVESİ -->
    <Border Background="{DynamicResource BrushBgDeep}" 
            BorderBrush="{DynamicResource BrushBorderSubtle}" 
            BorderThickness="1.5" 
            CornerRadius="10">
        
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <!-- 0: ÜST BAŞLIK, LOGO VE KONTROLLER -->
                <RowDefinition Height="Auto"/>
                <!-- 1: HESAP LİSTESİ -->
                <RowDefinition Height="*" MaxHeight="640"/>
                <!-- 2: ALT KONTROL BARI (FOOTER) -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======================================================== -->
            <!-- BÖLÜM 0: ÜST BAŞLIK, LOGO VE TELEMETRİ -->
            <!-- ======================================================== -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Logo & Uygulama Adı (Tıklanınca Resmi Web Sitesini Açar) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" 
                            Cursor="Hand" ToolTip="Resmi Web Sitesini Aç (https://haytokoraz.github.io/Lol-Account-Switcher/)"
                            MouseDown="BtnLogo_MouseDown">
                    <Border Width="32" Height="32" CornerRadius="16" BorderBrush="{DynamicResource BrushHextechGold}" BorderThickness="1.5" Margin="0,0,10,0" ClipToBounds="True">
                        <Image Source="logo.jpg" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock x:Name="TxtAppTitle" Text="Lol Account Switcher" Foreground="{DynamicResource BrushTextPrimary}" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BrushBgBadge}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Margin="8,0,0,0" Padding="5,2" VerticalAlignment="Center">
                        <TextBlock Text="v0.2" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Orta: 144Hz Rozeti -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="{DynamicResource BrushBgBadge}" BorderBrush="{DynamicResource BrushHextechCyan}" BorderThickness="1" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖥️ " FontSize="11"/>
                        <TextBlock x:Name="TxtHz" Text="144Hz" Foreground="{DynamicResource BrushHextechCyanGlow}" FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Sağ: Dil, Tema, Yenile, Web, Ayarlar, Minimize, Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Dil Değiştirici Buton (TR / EN) -->
                    <Button x:Name="BtnLangToggle" Content="TR" ToolTip="Dil Değiştir (TR / EN)" Style="{StaticResource HexToolBtnStyle}" FontWeight="Bold" FontSize="11" Padding="8,3" Margin="0,0,5,0" Click="BtnLangToggle_Click"/>
                    <!-- Hızlı Tema Değiştirici 🌓 -->
                    <Button x:Name="BtnThemeToggle" Content="🌓" ToolTip="Koyu / Açık Tema Değiştir" Style="{StaticResource HexToolBtnStyle}" Width="28" Height="26" Padding="0" Margin="0,0,5,0" Click="BtnThemeToggle_Click"/>
                    <!-- İstatistikleri Yenile 🔄 -->
                    <Button x:Name="BtnRefreshStats" Content="🔄" ToolTip="Tüm Hesapları Güncelle" Style="{StaticResource HexToolBtnStyle}" Width="28" Height="26" Padding="0" Margin="0,0,5,0" Click="BtnRefreshStats_Click"/>
                    <!-- Resmi Web Sitesi 🌐 -->
                    <Button x:Name="BtnWebPortal" Content="🌐" ToolTip="Resmi Web Sitesini Aç" Style="{StaticResource HexToolBtnStyle}" Width="28" Height="26" Padding="0" Margin="0,0,5,0" Tag="https://haytokoraz.github.io/Lol-Account-Switcher/" Click="BtnOpenUrl_Click"/>
                    <!-- Aktif Hesabı Otomatik Ekle ⚡ -->
                    <Button x:Name="BtnAutoAddHeader" Content="⚡ Ekle" ToolTip="Bilgisayarda açık olan LoL/Riot hesabını otomatik listeye ekle" Style="{StaticResource HexSwitchBtnStyle}" FontWeight="Bold" FontSize="11" Padding="7,2" Margin="0,0,5,0" Click="BtnAutoAddFirstAccount_Click"/>
                    <!-- Ayarlar ⚙️ -->
                    <Button x:Name="BtnSettings" Content="⚙️" ToolTip="Ayarlar" Style="{StaticResource HexToolBtnStyle}" Width="28" Height="26" Padding="0" Margin="0,0,5,0" Click="BtnSettings_Click"/>
                    <!-- Minimize — -->
                    <Button Content="—" Style="{StaticResource HexToolBtnStyle}" Width="26" Height="26" Padding="0" Margin="0,0,5,0" Click="BtnMinimize_Click"/>
                    <!-- Close ✕ -->
                    <Button Content="✕" Style="{StaticResource HexDangerBtnStyle}" Width="26" Height="26" Padding="0" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- BÖLÜM 1: DİNAMİK HESAP LİSTESİ -->
            <!-- ======================================================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="640" Margin="0,0,0,12">
                <ItemsControl x:Name="ItemsAccounts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1.2" CornerRadius="8" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Sol: BÜYÜTÜLMÜŞ AVATAR SİMGESİ (Tıklanınca Porofessor/LoG Profilini Açar) -->
                                    <Grid Grid.Column="0" Width="58" Height="58" VerticalAlignment="Center"
                                          Cursor="Hand" ToolTip="{Binding ProfileTooltip}"
                                          MouseDown="BtnAccountProfile_MouseDown">
                                        <Border Width="58" Height="58" CornerRadius="29" 
                                                BorderBrush="{DynamicResource BrushHextechGold}" BorderThickness="2" 
                                                Background="{DynamicResource BrushBgAvatar}" ClipToBounds="True">
                                            <Grid>
                                                <!-- Yedek Emoji -->
                                                <TextBlock Text="{Binding IconEmoji}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- Gerçek Profil Resmi -->
                                                <Image Source="{Binding ProfileImageUrl}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <!-- Seviye Rozeti (Level) -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="{DynamicResource BrushBgBadge}" BorderBrush="{DynamicResource BrushHextechCyan}"
                                                BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,-3,-3">
                                            <TextBlock Text="{Binding LevelText}" Foreground="{DynamicResource BrushHextechCyanGlow}" FontSize="9.5" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Orta: BÜYÜTÜLMÜŞ VE OKUNAKLI BİLGİ ALANI -->
                                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource BrushTextPrimary}" FontSize="15" FontWeight="Bold"/>
                                            <Border Background="{DynamicResource BrushBgBadge}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Server}" Foreground="{DynamicResource BrushHextechCyan}" FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                            <!-- League of Graphs Butonu -->
                                            <Button ToolTip="{Binding ProfileTooltip}" Style="{StaticResource HexToolBtnStyle}" 
                                                    Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" Height="22"
                                                    Tag="{Binding ProfileUrl}" Click="BtnOpenLoG_Click">
                                                <TextBlock Text="🌐 LoG" FontSize="9.5" FontWeight="Bold"/>
                                            </Button>

                                            <!-- Canlı Maç Butonu (Kırmızı Noktalı Porofessor) -->
                                            <Button ToolTip="{Binding LiveMatchTooltip}" Style="{StaticResource HexToolBtnStyle}" 
                                                    Padding="6,2" Margin="5,0,0,0" VerticalAlignment="Center" Height="22"
                                                    Tag="{Binding LiveUrl}" Click="BtnOpenLive_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="#FF4C4C" Margin="0,0,4,0"/>
                                                    <TextBlock Text="Canlı" FontSize="9.5" FontWeight="Bold" Foreground="#FF4C4C"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        
                                        <!-- Sihirdar Adı + Rank Amblemi + Rank Metni (Tıklanınca Porofessor/LoG Profilini Açar) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center"
                                                    Cursor="Hand" ToolTip="{Binding ProfileTooltip}"
                                                    MouseDown="BtnAccountProfile_MouseDown">
                                            <TextBlock Text="{Binding SummonerName}" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="  •  " Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                            
                                            <!-- Rank Amblemi (Büyütülmüş Simge) -->
                                            <Image Source="{Binding TierImageUrl}" Width="24" Height="24" Margin="0,0,6,0" VerticalAlignment="Center"/>

                                            <!-- Rank Metni (Örn: Gold IV • 5 LP) -->
                                            <TextBlock Text="{Binding Rank}" Foreground="{DynamicResource BrushHextechGold}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Sağ: BÜYÜTÜLMÜŞ Switch & Sil Butonları -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding SwitchBtnText}" Style="{StaticResource HexSwitchBtnStyle}" Padding="16,8" FontSize="12.5" FontWeight="Bold" Margin="0,0,8,0" Tag="{Binding Title}" Click="BtnAccountSwitch_Click"/>
                                        <Button ToolTip="{Binding DeleteBtnTooltip}" Style="{StaticResource HexDeleteBtnStyle}" Tag="{Binding Id}" Click="BtnAccountDelete_Click">
                                            <Viewbox Width="15" Height="15">
                                                <Canvas Width="24" Height="24">
                                                    <!-- Çöp Kutusu Kapağı ve Tutamağı -->
                                                    <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                          Data="M9,3 L15,3 C15.55,3 16,3.45 16,4 L16,5 L19.5,5 C19.8,5 20,5.2 20,5.5 C20,5.8 19.8,6 19.5,6 L4.5,6 C4.2,6 4,5.8 4,5.5 C4,5.2 4.2,5 4.5,5 L8,5 L8,4 C8,3.45 8.45,3 9,3 Z M9.5,4.2 L14.5,4.2 L14.5,5 L9.5,5 Z"/>
                                                    <!-- Çöp Kutusu Gövdesi ve İç Çizgiler -->
                                                    <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                          Data="M5.5,7 L18.5,7 L17.4,19.4 C17.3,20.3 16.5,21 15.6,21 L8.4,21 C7.5,21 6.7,20.3 6.6,19.4 L5.5,7 Z M9,9 C8.7,9 8.5,9.2 8.5,9.5 L8.5,18 C8.5,18.3 8.7,18.5 9,18.5 C9.3,18.5 9.5,18.28 9.5,18 L9.5,9.5 C9.5,9.2 9.3,9 9,9 Z M12,9 C11.7,9 11.5,9.2 11.5,9.5 L11.5,18 C11.5,18.3 11.7,18.5 12,18.5 C12.3,18.5 12.5,18.3 12.5,18 L12.5,9.5 C12.5,9.2 12.3,9 12,9 Z M15,9 C14.7,9 14.5,9.2 14.5,9.5 L14.5,18 C14.5,18.3 14.7,18.5 15,18.5 C15.3,18.5 15.5,18.3 15.5,18 L15.5,9.5 C15.5,9.2 15.3,9 15,9 Z"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- BOŞ LİSTE KARŞILAMA KARTI (İlk Kullanım / Sıfır Hesap Durumu) -->
            <Border x:Name="BorderEmptyState" Grid.Row="1" Visibility="Collapsed"
                    Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" 
                    BorderThickness="1.5" CornerRadius="10" Padding="30,24" Margin="0,10"
                    VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚔️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtEmptyTitle" Text="Henüz Kayıtlı Bir Hesap Yok" Foreground="{DynamicResource BrushHextechGold}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtEmptyDesc" Text="League of Legends profilinizi ekleyerek hızlı hesap geçişi yapabilirsiniz." Foreground="{DynamicResource BrushTextMuted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                    <Button x:Name="BtnAutoAddFirstAccount" Content="⚡ Açık LoL Hesabını Otomatik Ekle" Style="{StaticResource HexSwitchBtnStyle}" Padding="20,10" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center" Click="BtnAutoAddFirstAccount_Click"/>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!-- BÖLÜM 2: ALT KONTROL BARI (FOOTER) -->
            <!-- ======================================================== -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Araçlar -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnCfgLock" Content="🔒 Cfg" Style="{StaticResource HexToolBtnStyle}" Padding="10,5" FontSize="11.5" Margin="0,0,5,0" Click="BtnCfgLock_Click"/>
                    <Button x:Name="BtnAppData" Content="📁 AppData" Style="{StaticResource HexToolBtnStyle}" Padding="10,5" FontSize="11.5" Margin="0,0,5,0" Click="BtnAppData_Click"/>
                    <Button x:Name="BtnGeneralBackup" Content="💾 Genel" Style="{StaticResource HexToolBtnStyle}" Padding="10,5" FontSize="11.5" Click="BtnGeneralBackup_Click"/>
                </StackPanel>

                <!-- Orta: Acil LoL Kapat -->
                <Button x:Name="BtnKillLeague" Grid.Column="1" HorizontalAlignment="Center" Content="🛑 LOL KAPAT" Style="{StaticResource HexDangerBtnStyle}" Padding="18,6" FontSize="12" Margin="10,0" Click="BtnKillLeague_Click"/>

                <!-- Sağ: HaYTooL & HaYTo Portal Bağlantıları -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🌐 HaYTooL" ToolTip="HaYTooL Portalını Aç (https://haytokoraz.github.io/)" 
                            Style="{StaticResource HexToolBtnStyle}" Padding="6,2" FontSize="10" Margin="0,0,4,0" 
                            Tag="https://haytokoraz.github.io/" Click="BtnOpenUrl_Click"/>
                    <Button Content="𝕏 HaYTo" ToolTip="Developer X Profilini Aç (@HaYTo)" 
                            Style="{StaticResource HexToolBtnStyle}" Padding="6,2" FontSize="10" 
                            Tag="https://x.com/HaYTo" Click="BtnOpenUrl_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
