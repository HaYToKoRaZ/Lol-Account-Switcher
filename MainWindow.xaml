<Window x:Class="LolAccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lol Account Switcher" 
        Icon="app.ico"
        Width="780"
        MinWidth="640"
        MaxWidth="950"
        SizeToContent="Height"
        MaxHeight="880"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        MouseDown="Window_MouseDown">

    <!-- ANA PENCERE ÇERÇEVESİ -->
    <Border Background="{DynamicResource BrushBgDeep}" 
            BorderBrush="{DynamicResource BrushBorderSubtle}" 
            BorderThickness="1.5" 
            CornerRadius="10">
        
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <!-- 0: ÜST BAŞLIK, LOGO VE KONTROLLER -->
                <RowDefinition Height="Auto"/>
                <!-- 1: HESAP LİSTESİ -->
                <RowDefinition Height="*" MaxHeight="640"/>
                <!-- 2: ALT KONTROL BARI (FOOTER) -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- EKRAN İÇİ KOPYALANDI / İŞLEM BİLDİRİMİ (IN-APP TOAST NOTIFICATION) -->
            <Border x:Name="BorderToast" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Panel.ZIndex="999" Margin="0,52,0,0" Padding="16,8" CornerRadius="20"
                    Background="#F2091428" BorderBrush="{DynamicResource BrushHextechGold}" BorderThickness="1.5"
                    Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="#C8AA6E" BlurRadius="18" ShadowDepth="0" Opacity="0.75"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtToastIcon" Text="📋 " FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtToastMessage" Text="Panoya kopyalandı!" MaxWidth="550" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource BrushHextechGold}" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                    <TextBlock Text=" ✓" Foreground="#00FF88" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!-- BÖLÜM 0: ÜST BAŞLIK, LOGO VE TELEMETRİ -->
            <!-- ======================================================== -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Logo & Uygulama Adı (Tıklanınca Resmi Web Sitesini Açar) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" 
                            Cursor="Hand" ToolTip="Resmi Web Sitesini Aç (https://haytokoraz.github.io/Lol-Account-Switcher/)"
                            MouseDown="BtnLogo_MouseDown">
                    <Border Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Image Source="logo.png" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="TxtAppTitle" Text="Lol Account Switcher" Foreground="{DynamicResource BrushTextPrimary}" FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BrushBgBadge}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Margin="8,0,0,0" Padding="5,2" VerticalAlignment="Center">
                        <TextBlock Text="v3.7" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Orta: 144Hz Rozeti -->
                <Border x:Name="BorderHz" Grid.Column="1" HorizontalAlignment="Center" Background="{DynamicResource BrushBgBadge}" BorderBrush="{DynamicResource BrushHextechCyan}" BorderThickness="1" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖥️ " FontSize="11"/>
                        <TextBlock x:Name="TxtHz" Text="144Hz" Foreground="{DynamicResource BrushHextechCyanGlow}" FontWeight="Bold" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Sağ: Dil (Açılır Menü), Tema, Yenile, Web, Ayarlar, Minimize, Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Açılır Dil Menüsü Butonu (Ülke Bayrakları 🇹🇷 TR / 🇬🇧 EN) -->
                    <Button x:Name="BtnLangMenu" ToolTip="Uygulama Dili (Language)" Style="{StaticResource HexToolBtnStyle}" Padding="6,3" Margin="0,0,8,0" Click="BtnLangMenu_Click">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MenuLang" Style="{StaticResource HexContextMenuStyle}">
                                <MenuItem x:Name="MenuLangTR" Click="MenuLangTR_Click" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" Padding="6,5">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ContentControl Template="{StaticResource FlagTurkeyTemplate}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Türkçe (TR)" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="MenuLangEN" Click="MenuLangEN_Click" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" Padding="6,5">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ContentControl Template="{StaticResource FlagUKTemplate}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="English (EN)" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ContentControl x:Name="CurrentLangFlag" Template="{StaticResource FlagTurkeyTemplate}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtCurrentLangCode" Text="TR" FontSize="10.5" FontWeight="Bold" Margin="4,0,3,0" VerticalAlignment="Center"/>
                            <TextBlock Text="▾" FontSize="9" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Hızlı Tema Değiştirici 🌓 -->
                    <Button x:Name="BtnThemeToggle" Content="🌓" ToolTip="Koyu / Açık Tema Değiştir" Style="{StaticResource HexToolBtnStyle}" Width="28" Height="26" Padding="0" Margin="0,0,8,0" Click="BtnThemeToggle_Click"/>
                    <!-- İstatistikleri Yenile 🔄 -->
                    <Button x:Name="BtnRefreshStats" Content="🔄" ToolTip="Tüm Hesapları Güncelle" Style="{StaticResource HexToolBtnStyle}" Width="28" Height="26" Padding="0" Margin="0,0,8,0" Click="BtnRefreshStats_Click"/>
                    <!-- Resmi Web Sitesi 🌐 -->
                    <Button x:Name="BtnWebPortal" Content="🌐" ToolTip="Resmi Web Sitesini Aç" Style="{StaticResource HexToolBtnStyle}" Width="28" Height="26" Padding="0" Margin="0,0,8,0" Tag="https://haytokoraz.github.io/Lol-Account-Switcher/" Click="BtnOpenUrl_Click"/>
                    <!-- Aktif Hesabı Otomatik Ekle / Güncelle ⚡ -->
                    <Button x:Name="BtnAutoAddHeader" Content="⚡ Ekle / Güncelle" Style="{StaticResource HexAutoAddBtnStyle}" FontWeight="Bold" FontSize="11" Padding="8,3" Margin="0,0,8,0" Click="BtnAutoAddFirstAccount_Click"/>
                    <!-- Ayarlar ⚙️ -->
                    <Button x:Name="BtnSettings" Content="⚙️" ToolTip="Ayarlar" Style="{StaticResource HexToolBtnStyle}" Width="28" Height="26" Padding="0" Margin="0,0,8,0" Click="BtnSettings_Click"/>
                    <!-- Minimize — -->
                    <Button Content="—" Style="{StaticResource HexToolBtnStyle}" Width="26" Height="26" Padding="0" Margin="0,0,8,0" Click="BtnMinimize_Click"/>
                    <!-- Close ✕ -->
                    <Button Content="✕" Style="{StaticResource HexDangerBtnStyle}" Width="26" Height="26" Padding="0" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- ======================================================== -->
            <!-- BÖLÜM 1: DİNAMİK HESAP LİSTESİ -->
            <!-- ======================================================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="640" Margin="0,0,0,12">
                <ItemsControl x:Name="ItemsAccounts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" CornerRadius="8" Padding="14,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <!-- Normal Hesap Çerçevesi -->
                                        <Setter Property="Background" Value="{DynamicResource BrushBgCard}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                                        <Setter Property="BorderThickness" Value="1.2"/>
                                        <Style.Triggers>
                                            <!-- Aktif Profil Çerçevesi: Hextech Altın Vurgusu -->
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BrushBgCard}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushHextechGold}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Sol: BÜYÜTÜLMÜŞ AVATAR SİMGESİ (Dinamik Lig Çerçevesi & Glow) -->
                                    <Grid Grid.Column="0" Width="62" Height="62" VerticalAlignment="Center"
                                          Cursor="Hand" ToolTip="{Binding ProfileTooltip}"
                                          MouseDown="BtnAccountProfile_MouseDown">
                                        <!-- Dış Çerçeve (Lig Renginde Parlayan Çerçeve) -->
                                        <Border Width="60" Height="60" CornerRadius="30" 
                                                BorderBrush="{Binding TierBorderBrush}" BorderThickness="2.8" 
                                                Background="{DynamicResource BrushBgAvatar}" Padding="2.5"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{Binding TierColor}" BlurRadius="12" ShadowDepth="0" Opacity="{Binding TierGlowOpacity}"/>
                                            </Border.Effect>
                                            <Grid>
                                                <!-- Dairesel Maske: Resmin kare kenarlarının yuvarlak çerçeveyi örtmesini engeller -->
                                                <Grid.OpacityMask>
                                                    <VisualBrush>
                                                        <VisualBrush.Visual>
                                                            <Ellipse Width="55" Height="55" Fill="Black"/>
                                                        </VisualBrush.Visual>
                                                    </VisualBrush>
                                                </Grid.OpacityMask>
                                                <!-- Yedek Emoji -->
                                                <TextBlock Text="{Binding IconEmoji}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- Gerçek Profil Resmi -->
                                                <Image Source="{Binding ProfileImageUrl}" Stretch="UniformToFill"/>
                                            </Grid>
                                        </Border>
                                        <!-- Seviye Rozeti (Level) -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Background="{DynamicResource BrushBgBadge}" BorderBrush="{DynamicResource BrushHextechCyan}"
                                                BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,-2,-2">
                                            <TextBlock Text="{Binding LevelText}" Foreground="{DynamicResource BrushHextechCyanGlow}" FontSize="9.5" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Orta: BÜYÜTÜLMÜŞ VE OKUNAKLI BİLGİ ALANI -->
                                    <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                                        <!-- Satır 1: Hesap İsmi (Riot ID) + Sunucu Rozeti + Aktif Rozeti + LoG & Porofessor -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Riot ID / Kimlik (Tıklanınca Panoya Kopyalar) -->
                                            <Border Cursor="Hand" ToolTip="{Binding CopySummonerTooltip}"
                                                    Background="Transparent" MouseDown="BtnCopySummonerName_MouseDown">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CleanSummonerName}" Foreground="{DynamicResource BrushTextPrimary}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" 📋" FontSize="11" Foreground="{DynamicResource BrushHextechGold}" Opacity="0.85" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Sunucu Rozeti (SADECE 1 KEZ GÖSTERİLİR) -->
                                            <Border Background="{DynamicResource BrushBgBadge}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Server}" Foreground="{DynamicResource BrushHextechCyan}" FontSize="10.5" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Aktif Hesap Rozeti: Şık Yeşil Nokta + Hextech Altın Rozet -->
                                            <Border Visibility="{Binding ActiveBadgeVisibility}"
                                                    Background="{DynamicResource BrushBgBadge}" 
                                                    BorderBrush="{DynamicResource BrushHextechGold}" 
                                                    BorderThickness="1" CornerRadius="4" 
                                                    Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="#00E599" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding ActiveBadgeText}" Foreground="{DynamicResource BrushHextechGold}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- League of Graphs Butonu -->
                                            <Button ToolTip="{Binding ProfileTooltip}" Style="{StaticResource HexToolBtnStyle}" 
                                                    Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" Height="22"
                                                    Tag="{Binding ProfileUrl}" Click="BtnOpenLoG_Click">
                                                <TextBlock Text="🌐 LoG" FontSize="9.5" FontWeight="Bold"/>
                                            </Button>

                                            <!-- Canlı Maç Butonu (Kırmızı Noktalı Porofessor) -->
                                            <Button ToolTip="{Binding LiveMatchTooltip}" Style="{StaticResource HexToolBtnStyle}" 
                                                    Padding="6,2" Margin="5,0,0,0" VerticalAlignment="Center" Height="22"
                                                    Tag="{Binding LiveUrl}" Click="BtnOpenLive_Click">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="#FF4C4C" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding LiveBtnText}" FontSize="9.5" FontWeight="Bold" Foreground="#FF4C4C"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        
                                        <!-- Satır 2: Rank Amblemi + Rank Metni (Tıklanınca LoG/Porofessor Açar) -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                                            <Border Cursor="Hand" ToolTip="{Binding ProfileTooltip}"
                                                    Background="Transparent" MouseDown="BtnAccountProfile_MouseDown">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Rank Amblemi (Büyütülmüş Prestijli Simge: 36x36) -->
                                                    <Image Source="{Binding TierImageUrl}" Width="36" Height="36" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                                    <!-- Rank Metni (Örn: Gold IV • 5 LP) - Ligin Gerçek Renginde -->
                                                    <TextBlock Text="{Binding Rank}" Foreground="{Binding TierBorderBrush}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Satır 3: E-Posta / İpucu, Not & Düzenle Butonu -->
                                        <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center">
                                            <!-- E-posta Rozeti (Tıklanınca Panoya Kopyalar) -->
                                            <Border Visibility="{Binding EmailBadgeVisibility}" Cursor="Hand"
                                                    ToolTip="{Binding CopyEmailTooltip}"
                                                    Background="{DynamicResource BrushBgBadge}" BorderBrush="{DynamicResource BrushHextechCyan}"
                                                    BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,2"
                                                    Tag="{Binding Email}" MouseDown="BtnCopyEmail_MouseDown">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📧 " FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding DisplayEmail}" Foreground="{DynamicResource BrushHextechCyanGlow}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text=" 📋" FontSize="9.5" Foreground="{DynamicResource BrushHextechCyan}" Opacity="0.8" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Not Rozeti (Tıklanınca da düzenleme penceresini açar) -->
                                            <Border Visibility="{Binding NoteBadgeVisibility}" Cursor="Hand"
                                                    ToolTip="{Binding EditAccountTooltip}"
                                                    Background="{DynamicResource BrushBgBadge}" BorderBrush="{DynamicResource BrushHextechGold}"
                                                    BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,2"
                                                    VerticalAlignment="Center" Tag="{Binding}" MouseDown="BtnNoteBadge_MouseDown">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📝 " FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Note}" Foreground="{DynamicResource BrushHextechGold}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Sağ: Sıralama, Düzenle, Switch & Sil Butonları -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Sıralama: Yukarı / Aşağı Butonları -->
                                        <StackPanel Orientation="Vertical" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Button ToolTip="{Binding MoveUpTooltip}" Style="{StaticResource HexToolBtnStyle}"
                                                    Width="24" Height="15" Margin="0,0,0,2" Padding="0" VerticalAlignment="Center"
                                                    Tag="{Binding}" Click="BtnMoveAccountUp_Click">
                                                <TextBlock Text="▲" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
                                            </Button>
                                            <Button ToolTip="{Binding MoveDownTooltip}" Style="{StaticResource HexToolBtnStyle}"
                                                    Width="24" Height="15" Padding="0" VerticalAlignment="Center"
                                                    Tag="{Binding}" Click="BtnMoveAccountDown_Click">
                                                <TextBlock Text="▼" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Not & E-posta Düzenle Butonu (Geçiş Yap Solunda, Ufak & Göze Batmayan) -->
                                        <Button ToolTip="{Binding EditAccountTooltip}" Style="{StaticResource HexToolBtnStyle}"
                                                Width="30" Height="32" Margin="0,0,8,0" Padding="0" VerticalAlignment="Center"
                                                Tag="{Binding}" Click="BtnEditAccount_Click">
                                            <TextBlock Text="✏️" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"/>
                                        </Button>

                                        <Button Content="{Binding SwitchBtnText}" Style="{StaticResource HexSwitchBtnStyle}" Padding="16,8" FontSize="12.5" FontWeight="Bold" Margin="0,0,8,0" Tag="{Binding Title}" Click="BtnAccountSwitch_Click"/>
                                        <Button ToolTip="{Binding DeleteBtnTooltip}" Style="{StaticResource HexDeleteBtnStyle}" Tag="{Binding Id}" Click="BtnAccountDelete_Click">
                                            <Viewbox Width="15" Height="15">
                                                <Canvas Width="24" Height="24">
                                                    <!-- Çöp Kutusu Kapağı ve Tutamağı -->
                                                    <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                          Data="M9,3 L15,3 C15.55,3 16,3.45 16,4 L16,5 L19.5,5 C19.8,5 20,5.2 20,5.5 C20,5.8 19.8,6 19.5,6 L4.5,6 C4.2,6 4,5.8 4,5.5 C4,5.2 4.2,5 4.5,5 L8,5 L8,4 C8,3.45 8.45,3 9,3 Z M9.5,4.2 L14.5,4.2 L14.5,5 L9.5,5 Z"/>
                                                    <!-- Çöp Kutusu Gövdesi ve İç Çizgiler -->
                                                    <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                          Data="M5.5,7 L18.5,7 L17.4,19.4 C17.3,20.3 16.5,21 15.6,21 L8.4,21 C7.5,21 6.7,20.3 6.6,19.4 L5.5,7 Z M9,9 C8.7,9 8.5,9.2 8.5,9.5 L8.5,18 C8.5,18.3 8.7,18.5 9,18.5 C9.3,18.5 9.5,18.28 9.5,18 L9.5,9.5 C9.5,9.2 9.3,9 9,9 Z M12,9 C11.7,9 11.5,9.2 11.5,9.5 L11.5,18 C11.5,18.3 11.7,18.5 12,18.5 C12.3,18.5 12.5,18.3 12.5,18 L12.5,9.5 C12.5,9.2 12.3,9 12,9 Z M15,9 C14.7,9 14.5,9.2 14.5,9.5 L14.5,18 C14.5,18.3 14.7,18.5 15,18.5 C15.3,18.5 15.5,18.3 15.5,18 L15.5,9.5 C15.5,9.2 15.3,9 15,9 Z"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- BOŞ LİSTE KARŞILAMA KARTI (İlk Kullanım / Sıfır Hesap Durumu) -->
            <Border x:Name="BorderEmptyState" Grid.Row="1" Visibility="Collapsed"
                    Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" 
                    BorderThickness="1.5" CornerRadius="10" Padding="30,24" Margin="0,10"
                    VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚔️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtEmptyTitle" Text="Henüz Kayıtlı Bir Hesap Yok" Foreground="{DynamicResource BrushHextechGold}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtEmptyDesc" Text="League of Legends profilinizi ekleyerek hızlı hesap geçişi yapabilirsiniz." Foreground="{DynamicResource BrushTextMuted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                    <Button x:Name="BtnAutoAddFirstAccount" Content="⚡ Açık Hesabı Kaydet / Güncelle" Style="{StaticResource HexAutoAddBtnStyle}" Padding="20,10" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center" Click="BtnAutoAddFirstAccount_Click"/>
                </StackPanel>
            </Border>

            <!-- ======================================================== -->
            <!-- BÖLÜM 2: ALT KONTROL BARI (FOOTER) -->
            <!-- ======================================================== -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sol: Araçlar -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnCfgLock" Content="🔒 Cfg" Style="{StaticResource HexToolBtnStyle}" Padding="10,5" FontSize="11.5" Margin="0,0,5,0" Click="BtnCfgLock_Click"/>
                    <Button x:Name="BtnAppData" Content="📁 AppData" Style="{StaticResource HexToolBtnStyle}" Padding="10,5" FontSize="11.5" Margin="0,0,5,0" Visibility="Collapsed" Click="BtnAppData_Click"/>
                    <Button x:Name="BtnPatchNotes" Content="📜 Yama Notları" Style="{StaticResource HexToolBtnStyle}" Padding="10,5" FontSize="11.5" Margin="0,0,5,0" Click="BtnPatchNotes_Click"/>
                    <Button x:Name="BtnWiki" Content="📖 Wiki" Style="{StaticResource HexToolBtnStyle}" Padding="10,5" FontSize="11.5" Click="BtnWiki_Click"/>
                </StackPanel>

                <!-- Orta: LoL'ü Aç ve LoL'ü Kapat Butonları -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="BtnLaunchLeague" Style="{StaticResource HexToolBtnStyle}" Padding="12,5" Margin="0,0,8,0" Click="BtnLaunchLeague_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="logo.png" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtLaunchLeague" Text="LoL'ü Aç" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnKillLeague" Content="🛑 LOL KAPAT" Style="{StaticResource HexDangerBtnStyle}" Padding="16,6" FontSize="12" Click="BtnKillLeague_Click"/>
                </StackPanel>

                <!-- Sağ: HaYTooL Portal Bağlantısı -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🌐 HaYTooL" ToolTip="HaYTooL Portalını Aç (https://haytokoraz.github.io/)" 
                            Style="{StaticResource HexToolBtnStyle}" Padding="8,4" FontSize="11" 
