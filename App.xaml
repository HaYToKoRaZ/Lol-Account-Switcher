<Application x:Class="LolAccountSwitcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- SEMANTİK DİNAMİK FIRÇALAR (ThemeManager Üzerinden Anlık Değiştirilir) -->
        <SolidColorBrush x:Key="BrushBgDeep" Color="#070C14" />
        <SolidColorBrush x:Key="BrushBgCard" Color="#0E1B2C" />
        <SolidColorBrush x:Key="BrushBgBadge" Color="#142940" />
        <SolidColorBrush x:Key="BrushBgAvatar" Color="#0A1B29" />
        <SolidColorBrush x:Key="BrushBorderSubtle" Color="#1E3958" />
        <SolidColorBrush x:Key="BrushBorderHover" Color="#C8AA6E" />
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#F0E6D2" />
        <SolidColorBrush x:Key="BrushTextMuted" Color="#8E9DAE" />
        <SolidColorBrush x:Key="BrushHextechGold" Color="#C8AA6E" />
        <SolidColorBrush x:Key="BrushHextechGoldBright" Color="#F0E6D2" />
        <SolidColorBrush x:Key="BrushHextechCyan" Color="#0AC8B9" />
        <SolidColorBrush x:Key="BrushHextechCyanGlow" Color="#2BEBE0" />
        <SolidColorBrush x:Key="BrushToolBtnBg" Color="#112033" />
        <SolidColorBrush x:Key="BrushToolBtnHover" Color="#1A324E" />

        <SolidColorBrush x:Key="BrushSwitchBtnBg" Color="#092B45" />
        <SolidColorBrush x:Key="BrushSwitchBtnHover" Color="#0F446D" />
        <SolidColorBrush x:Key="BrushSwitchBtnText" Color="#2BEBE0" />
        <SolidColorBrush x:Key="BrushSwitchBtnBorder" Color="#0AC8B9" />

        <SolidColorBrush x:Key="BrushBackupBtnBg" Color="#1C2B18" />
        <SolidColorBrush x:Key="BrushBackupBtnHover" Color="#2D3E24" />
        <SolidColorBrush x:Key="BrushBackupBtnText" Color="#C8AA6E" />
        <SolidColorBrush x:Key="BrushBackupBtnBorder" Color="#C8AA6E" />

        <SolidColorBrush x:Key="BrushDanger" Color="#E84057" />
        <SolidColorBrush x:Key="BrushDangerBg" Color="#3D0E17" />
        <SolidColorBrush x:Key="BrushDangerHover" Color="#661424" />
        <SolidColorBrush x:Key="BrushDangerText" Color="#FFA4B2" />

        <SolidColorBrush x:Key="BrushInputBg" Color="#0D1A2D" />
        <SolidColorBrush x:Key="BrushInputText" Color="#F0E6D2" />

        <!-- ======================================================== -->
        <!-- VEKTÖREL ÜLKE BAYRAKLARI (Direct WPF Geometry - Sıfır Font Bağımlılığı) -->
        <!-- ======================================================== -->
        <!-- TÜRKİYE BAYRAĞI -->
        <ControlTemplate x:Key="FlagTurkeyTemplate">
            <Viewbox Width="20" Height="13" Stretch="Uniform">
                <Canvas Width="30" Height="20" ClipToBounds="True">
                    <Rectangle Width="30" Height="20" Fill="#E30A17" RadiusX="2" RadiusY="2"/>
                    <Ellipse Width="10" Height="10" Canvas.Left="6.5" Canvas.Top="5" Fill="White"/>
                    <Ellipse Width="8" Height="8" Canvas.Left="8.5" Canvas.Top="6" Fill="#E30A17"/>
                    <Path Fill="White" Data="M 17,10 L 15.5,10.8 L 16.1,9.2 L 14.8,8.2 L 16.4,8.2 L 17,6.8 L 17.6,8.2 L 19.2,8.2 L 17.9,9.2 L 18.5,10.8 Z"/>
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <!-- UK / GLOBAL İNGİLTERE BAYRAĞI -->
        <ControlTemplate x:Key="FlagUKTemplate">
            <Viewbox Width="20" Height="13" Stretch="Uniform">
                <Canvas Width="30" Height="20" ClipToBounds="True">
                    <Rectangle Width="30" Height="20" Fill="#012169" RadiusX="2" RadiusY="2"/>
                    <Path Stroke="White" StrokeThickness="3.5" Data="M 0,0 L 30,20 M 30,0 L 0,20"/>
                    <Path Stroke="#C8102E" StrokeThickness="1.8" Data="M 0,0 L 30,20 M 30,0 L 0,20"/>
                    <Path Stroke="White" StrokeThickness="5.5" Data="M 15,0 L 15,20 M 0,10 L 30,10"/>
                    <Path Stroke="#C8102E" StrokeThickness="3" Data="M 15,0 L 15,20 M 0,10 L 30,10"/>
                </Canvas>
            </Viewbox>
        </ControlTemplate>

        <!-- ======================================================== -->
        <!-- DİNAMİK BUTON VE KONTROL STİLLERİ -->
        <!-- ======================================================== -->
        <!-- GEÇİŞ YAP BUTONU -->
        <Style x:Key="HexSwitchBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushSwitchBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushSwitchBtnText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushSwitchBtnBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushSwitchBtnHover}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushHextechCyanGlow}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ÖZEL HEXTECH OTOMATİK HESAP EKLE BUTONU (KESKİN VE TEMİZ VEKTÖREL HEXTECH STİLİ) -->
        <Style x:Key="HexAutoAddBtnStyle" TargetType="Button">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A1E0E" Offset="0.0"/>
                        <GradientStop Color="#0E1B2C" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource BrushHextechGoldBright}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHextechGold}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3D2B14" Offset="0.0"/>
                                            <GradientStop Color="#142940" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushHextechCyanGlow}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1208" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- YEDEKLEME BUTONU -->
        <Style x:Key="HexBackupBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushBackupBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushBackupBtnText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBackupBtnBorder}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushBackupBtnHover}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushHextechGoldBright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TEHLİKE / ACİL KAPAT BUTONU -->
        <Style x:Key="HexDangerBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushDangerBg}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushDangerText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushDangerHover}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HESAP SİLME BUTONU (ÖZEL VEKTÖREL ÇÖP KUTUSU & MİKRO HOVER) -->
        <Style x:Key="HexDeleteBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushDangerBg}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushDangerText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushDangerHover}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF5C75" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A0A10" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ARAÇ / MENÜ BUTONLARI -->
        <Style x:Key="HexToolBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushToolBtnBg}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BrushToolBtnHover}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushHextechGold}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- HEX DİL AÇILIR MENÜ STİLİ -->
        <Style x:Key="HexContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource BrushBgCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHextechGold}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- KAPSAMLI COMBOBOX STİLİ (Tema ile %100 Uyumlu) -->
        <ControlTemplate x:Key="HexComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="4"
                        Background="{DynamicResource BrushBgCard}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                        BorderThickness="1" />
                <Border Grid.Column="0" Margin="1" Background="{DynamicResource BrushBgCard}" CornerRadius="4,0,0,4" />
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource BrushHextechGold}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrushHextechGold}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Template="{StaticResource HexComboBoxToggleButton}"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,6,26,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource BrushBgCard}"
                                            BorderBrush="{DynamicResource BrushHextechGold}"
                                            BorderThickness="1" CornerRadius="5" Margin="0,2,0,4">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX AÇILIR LİSTE ÖĞELERİ STİLİ -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource BrushBgCard}" />
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BrushToolBtnHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushHextechGoldBright}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource BrushSwitchBtnBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource BrushHextechCyanGlow}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================================================== -->
        <!-- ÖZEL HEXTECH TOAST STİLİNDE TOOLTIP ŞABLONU              -->
        <!-- ======================================================== -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F2091428"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushHextechGold}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushHextechGold}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="150"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="100"/>
            <Setter Property="ToolTipService.ShowDuration" Value="12000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                MaxWidth="440">
                            <Border.Effect>
                                <DropShadowEffect Color="#C8AA6E" BlurRadius="16" ShadowDepth="0" Opacity="0.75"/>
                            </Border.Effect>
                            <ContentPresenter VerticalAlignment="Center" 
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
