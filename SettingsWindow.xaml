<Window x:Class="LolAccountSwitcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - Lol Account Switcher" 
        Icon="app.ico"
        Width="540"
        MinWidth="500"
        MaxWidth="650"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        MouseDown="Window_MouseDown">

    <Border Background="{DynamicResource BrushBgDeep}" 
            BorderBrush="{DynamicResource BrushHextechGold}" 
            BorderThickness="1.5" 
            CornerRadius="10">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Üst Başlık & Kapat -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSettingsHeader" Text="Settings &amp; Accounts" Foreground="{DynamicResource BrushTextPrimary}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" Style="{StaticResource HexDangerBtnStyle}" Width="28" Height="26" Padding="0" Click="BtnClose_Click"/>
            </Grid>

            <!-- Form Alanı -->
            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <!-- Tema ve Dil Seçenekleri Paneli -->
                <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="14,12" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Tema Ayarı -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtThemeHeader" Text="Görünüm Teması:" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCurrentTheme" Text=" [Koyu / Dark]" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnToggleTheme" HorizontalAlignment="Right" Content="Tema Değiştir 🌓" Style="{StaticResource HexToolBtnStyle}" Padding="10,4" FontSize="11.5" Click="BtnToggleTheme_Click"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,2,0,10"/>

                        <!-- Dil Ayarı -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtLangHeader" Text="Uygulama Dili:" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtCurrentLang" Text=" [TR / Türkçe]" Foreground="{DynamicResource BrushHextechCyan}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnToggleLang" HorizontalAlignment="Right" Content="Dili Değiştir 🌐" Style="{StaticResource HexToolBtnStyle}" Padding="10,4" FontSize="11.5" Click="BtnToggleLang_Click"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,2,0,10"/>

                        <!-- LoL & Riot Otomatik Kapatma Ayarı -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtCloseLeagueHeader" Text="Hesap Geçişinde LoL/Riot Kapat:" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtCloseLeagueSub" Text="Profil değişirken istemcileri otomatik kapat" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkCloseLeague" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" Checked="ChkCloseLeague_Changed" Unchecked="ChkCloseLeague_Changed"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,2,0,10"/>

                        <!-- LoL & Riot Otomatik Başlatma Ayarı -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtAutoLaunchHeader" Text="Hesap Geçişinde LoL'ü Otomatik Başlat:" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtAutoLaunchSub" Text="Profil yüklendiğinde League of Legends'ı otomatik açar" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAutoLaunchGame" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" Checked="ChkAutoLaunchGame_Changed" Unchecked="ChkAutoLaunchGame_Changed"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,2,0,10"/>

                        <!-- Açılışta Rank & Profil Güncelleme Ayarı -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtAutoRefreshStatsHeader" Text="Açılışta Rank &amp; Profilleri Güncelle:" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtAutoRefreshStatsSub" Text="Uygulama açıldığında tüm hesapların dereceli ve seviye verilerini otomatik yeniler" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAutoRefreshStats" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" Checked="ChkAutoRefreshStats_Changed" Unchecked="ChkAutoRefreshStats_Changed"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,2,0,10"/>

                        <!-- Açılışta Hoş Geldin Sesi Çalma Ayarı -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtPlayStartupSoundHeader" Text="Uygulama Açılışında Hoş Geldin Sesini Çal:" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtPlayStartupSoundSub" Text="Uygulama başladığında yumuşak bir açılış sesi (sounds/startup.mp3) çalar" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkPlayStartupSound" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" Checked="ChkPlayStartupSound_Changed" Unchecked="ChkPlayStartupSound_Changed"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,2,0,10"/>

                        <!-- Yardımcı Uygulama (Companion App) Otomatik Başlatma Ayarı -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtLaunchCompanionAppHeader" Text="Hesap Geçişinde Yardımcı Uygulamayı Başlat:" Foreground="{DynamicResource BrushTextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtLaunchCompanionAppSub" Text="Profil değiştiğinde Blitz, Porofessor, Mobalytics vb. yardımcı uygulamanızı otomatik açar" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="15"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkLaunchCompanionApp" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="False" Checked="ChkLaunchCompanionApp_Changed" Unchecked="ChkLaunchCompanionApp_Changed"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,2,0,10"/>

                        <!-- Hesap Değişiminde Geçilecek Güç Planı -->
                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtSwitchPowerPlan" Grid.Row="0" Text="Hesap Geçişi Güç Planı:" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbSwitchPowerPlan" Grid.Row="1" Background="{DynamicResource BrushBgCard}" Foreground="{DynamicResource BrushTextPrimary}" Padding="8,5" FontSize="12" SelectionChanged="CmbSwitchPowerPlan_SelectionChanged"/>
                        </Grid>

                        <!-- LoL Kapatıldığında Geçilecek Güç Planı -->
                        <Grid Margin="0,4,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtKillLeaguePowerPlan" Grid.Row="0" Text="LoL Kapat Güç Planı:" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbKillLeaguePowerPlan" Grid.Row="1" Background="{DynamicResource BrushBgCard}" Foreground="{DynamicResource BrushTextPrimary}" Padding="8,5" FontSize="12" SelectionChanged="CmbKillLeaguePowerPlan_SelectionChanged"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,2,0,10"/>

                        <!-- Hesap Geçişi Monitör Tazeleme Hızı (Hz) -->
                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtSwitchRefreshRate" Grid.Row="0" Text="Hesap Geçişi Ekran Hızı (Hz):" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbSwitchRefreshRate" Grid.Row="1" Background="{DynamicResource BrushBgCard}" Foreground="{DynamicResource BrushTextPrimary}" Padding="8,5" FontSize="12" SelectionChanged="CmbSwitchRefreshRate_SelectionChanged"/>
                        </Grid>

                        <!-- LoL Kapat Monitör Tazeleme Hızı (Hz) -->
                        <Grid Margin="0,4,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtKillLeagueRefreshRate" Grid.Row="0" Text="LoL Kapat Ekran Hızı (Hz):" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbKillLeagueRefreshRate" Grid.Row="1" Background="{DynamicResource BrushBgCard}" Foreground="{DynamicResource BrushTextPrimary}" Padding="8,5" FontSize="12" SelectionChanged="CmbKillLeagueRefreshRate_SelectionChanged"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,2,0,10"/>

                        <!-- 1. Riot Games Ana Kurulum Klasörü -->
                        <Grid Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtRiotGamesPathLabel" Grid.Row="0" Text="Riot Games Kurulum Klasörü:" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtRiotGamesPath" Grid.Column="0" Background="{DynamicResource BrushBgCard}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,5" FontSize="11.5" Margin="0,0,6,0" TextChanged="TxtRiotGamesPath_TextChanged"/>
                                <Button x:Name="BtnDetectRiotPath" Grid.Column="1" Content="🎯 Algıla" Style="{StaticResource HexToolBtnStyle}" Padding="8,4" FontSize="11.5" Margin="0,0,4,0" Click="BtnDetectRiotPath_Click"/>
                                <Button x:Name="BtnBrowseRiotPath" Grid.Column="2" Content="📁 Seç" Style="{StaticResource HexToolBtnStyle}" Padding="8,4" FontSize="11.5" Click="BtnBrowseRiotPath_Click"/>
                            </Grid>
                        </Grid>

                        <!-- 2. Riot İstemci & Profil Veri Klasörü (AppData) -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtRiotProfilePathLabel" Grid.Row="0" Text="Riot İstemci &amp; Profil Veri Klasörü (AppData):" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtRiotProfilePath" Grid.Column="0" Background="{DynamicResource BrushBgCard}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,5" FontSize="11.5" Margin="0,0,6,0" TextChanged="TxtRiotProfilePath_TextChanged"/>
                                <Button x:Name="BtnDetectProfilePath" Grid.Column="1" Content="🎯 Algıla" Style="{StaticResource HexToolBtnStyle}" Padding="8,4" FontSize="11.5" Margin="0,0,4,0" Click="BtnDetectProfilePath_Click"/>
                                <Button x:Name="BtnBrowseProfilePath" Grid.Column="2" Content="📁 Seç" Style="{StaticResource HexToolBtnStyle}" Padding="8,4" FontSize="11.5" Click="BtnBrowseProfilePath_Click"/>
                            </Grid>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,10,0,10"/>

                        <!-- 3. Yardımcı Uygulama (.exe) Dosya Yolu (Blitz, Porofessor, Mobalytics vb.) -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="TxtCompanionAppPathLabel" Grid.Row="0" Text="Yardımcı Uygulama Yolu (Blitz, Porofessor vb.):" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCompanionAppPath" Grid.Column="0" Background="{DynamicResource BrushBgCard}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,5" FontSize="11.5" Margin="0,0,6,0" TextChanged="TxtCompanionAppPath_TextChanged"/>
                                <Button x:Name="BtnDetectCompanionAppPath" Grid.Column="1" Content="🎯 Algıla" Style="{StaticResource HexToolBtnStyle}" Padding="8,4" FontSize="11.5" Margin="0,0,4,0" Click="BtnDetectCompanionAppPath_Click"/>
                                <Button x:Name="BtnBrowseCompanionAppPath" Grid.Column="2" Content="📁 Seç" Style="{StaticResource HexToolBtnStyle}" Padding="8,4" FontSize="11.5" Click="BtnBrowseCompanionAppPath_Click"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hakkında & Yayıncı / Geliştirici Kartı -->
                <Border Background="{DynamicResource BrushBgCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="7" Padding="12,10" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Hakkında &amp; İletişim" Foreground="{DynamicResource BrushHextechGold}" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                        
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="Yayıncı: HaYTooL • Dev: HaYTo" Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="E-Posta: korazhayto@gmail.com" Foreground="{DynamicResource BrushTextMuted}" FontSize="10.5" Margin="0,2,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🌐 Portal" ToolTip="HaYTooL Portalı (https://haytokoraz.github.io/)" Style="{StaticResource HexToolBtnStyle}" Padding="6,3" FontSize="10" Margin="0,0,4,0" Tag="https://haytokoraz.github.io/" Click="BtnOpenUrl_Click"/>
                                <Button Content="🌐 Web" ToolTip="Uygulama Web Sitesi" Style="{StaticResource HexToolBtnStyle}" Padding="6,3" FontSize="10" Margin="0,0,4,0" Tag="https://haytokoraz.github.io/Lol-Account-Switcher/" Click="BtnOpenUrl_Click"/>
                                <Button Content="𝕏 HaYTo" ToolTip="Developer X Profili (@HaYTo)" Style="{StaticResource HexToolBtnStyle}" Padding="6,3" FontSize="10" Tag="https://x.com/HaYTo" Click="BtnOpenUrl_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Alt Kapat -->
            <Button x:Name="BtnCloseBottom" Grid.Row="2" Content="Kapat" Style="{StaticResource HexToolBtnStyle}" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="16,5" FontSize="12" Click="BtnClose_Click"/>
        </Grid>
    </Border>
</Window>
